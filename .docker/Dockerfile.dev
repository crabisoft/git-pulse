# Dev image: Node + OpenSSL (Prisma needs system libssl, absent from the slim
# base), plus the Python toolchain the user guide is built with. Source code is
# bind-mounted at runtime, so nothing of it is copied here.
ARG NODE_IMAGE=node:24-slim
FROM ${NODE_IMAGE}
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       openssl ca-certificates make python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

# Sphinx builds the guide in `docs/user/`. It lives in a virtualenv of its own
# because Debian's Python is externally managed, and because the guide's pinned
# versions have no business meeting the system packages.
#
# The requirements file is the one thing copied at build time, and deliberately:
# installing it into the image is what makes `make docs` a build rather than a
# download. Editing it means rebuilding the image, which `make dev` does.
ENV DOCS_VENV=/opt/docs-venv
COPY docs/user/requirements.txt /tmp/docs-requirements.txt
RUN python3 -m venv $DOCS_VENV \
  && $DOCS_VENV/bin/pip install --no-cache-dir -r /tmp/docs-requirements.txt \
  && rm /tmp/docs-requirements.txt

# Sphinx calls `setlocale(LC_ALL, "")` on startup and dies where the locale is
# unset, which a slim image is.
ENV LANG=C.UTF-8

WORKDIR /app

# The dependency directories are named volumes, and a volume created empty takes
# the ownership of the image directory it covers. The checks container installs
# as whoever asked for it — 1000 on a workstation, 1001 on a GitHub runner — so
# these are made writable by any of them rather than owned by one: npm has to be
# able to populate them whatever id it runs as. The stack's own services run as
# root and are unaffected.
RUN mkdir -p /app/node_modules /app/back/node_modules /app/front/node_modules \
             /app/packages/shared/node_modules \
  && chmod 0777 /app/node_modules /app/back/node_modules /app/front/node_modules \
                /app/packages/shared/node_modules
