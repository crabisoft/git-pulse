# Copy this file to .docker/.env.local to customize your dev environment.
# .env.local is git-ignored and overrides the values in .docker/.env.
# Only set what you want to override.
#
# Examples:
# WEB_PORT=9090
# API_PORT=3100
# POSTGRES_PORT=55432
# POSTGRES_PASSWORD=a_local_password
# VITE_API_URL=http://localhost:3100
