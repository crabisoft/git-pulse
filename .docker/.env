# ─────────────────────────────────────────────────────────────────────
# Default Docker environment values (VERSIONED).
# Do NOT put real secrets here. To override a value, create
# .docker/.env.local (git-ignored) — it takes precedence at launch.
# ─────────────────────────────────────────────────────────────────────

# ─── Host ports ──────────────────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3001
WEB_PORT=8080
# Vite dev server port (watch mode: npm run docker:dev)
WEB_PORT_DEV=5173

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard

# ─── API ─────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:8080
# Master key location inside the container (master-key volume).
MASTER_KEY_FILE=/data/master.key
# Collection schedule (cron). Default: every 15 minutes.
COLLECT_CRON=*/15 * * * *

# ─── Web (injected at build time) ────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ─── Images ──────────────────────────────────────────────────────────
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# Node image used by the dev containers (watch mode).
# Debian slim (not Alpine) so Prisma finds libssl/OpenSSL 3.
NODE_IMAGE=node:20-slim
