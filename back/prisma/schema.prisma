// Prisma schema — sources and dashboard core, EnvRule, MetricSnapshot.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  github
  gitlab
}

enum AuthKind {
  token
  app
}

/// A Git data source (GitHub or GitLab) with its tracking scope.
model Source {
  id        String     @id @default(uuid())
  name      String
  /// URL-safe form of the name, used by the frontend routes.
  slug      String     @unique
  kind      SourceKind
  baseUrl   String
  authKind  AuthKind
  /// ScopeRules payload: { owner, include[], exclude[] }.
  scope     Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  credential Credential?
  envRules   EnvRule[]
  snapshots  MetricSnapshot[]
}

/// Access secret for a source, encrypted at rest (AES-256-GCM envelope).
/// Plaintext is never stored — see CryptoService.
model Credential {
  id         String   @id @default(uuid())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String   @unique
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  /// Master key version that encrypted this secret (for rotation).
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum EnvRuleKind {
  simple
  meta
}

/// What the pattern is matched against: an environment name, or a repo name.
enum RuleTarget {
  environment
  repository
}

/// RegEx-based classification rule.
/// simple: extracts attributes via named groups (type, client, ...).
/// meta:   groups every name matching the pattern.
model EnvRule {
  id         String      @id @default(uuid())
  source     Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String
  name       String
  pattern    String
  kind       EnvRuleKind
  target     RuleTarget  @default(environment)
  /// Client-defined priority (lower wins).
  priority   Int         @default(100)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([sourceId, target, priority])
}

/// Application-wide setting, editable from the UI. A missing key falls back to
/// the matching environment variable, then to the built-in default.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Historized metric snapshot — the basis for DORA trends.
model MetricSnapshot {
  id         String   @id @default(uuid())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String
  metric     String
  value      Float
  /// Aggregation dimensions (env type, client, repo, ...).
  dimensions Json
  capturedAt DateTime @default(now())

  @@index([sourceId, metric, capturedAt])
}
