// Prisma schema — sources and dashboard core, EnvRule, MetricSnapshot.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  github
  gitlab
}

enum AuthKind {
  token
  app
}

/// Where the dashboard reads a source from.
///
/// `live` calls the provider on every request, which costs one rate-limit
/// budget per visitor. `stored` reads what the ingestion wrote, which costs one
/// per collection whatever the traffic — the whole point of the mode.
enum SourceMode {
  live
  stored
}

/// A Git data source (GitHub or GitLab) with its tracking scope.
model Source {
  id        String     @id @default(uuid())
  name      String
  /// URL-safe form of the name, used by the frontend routes.
  slug      String     @unique
  kind      SourceKind
  baseUrl   String
  authKind  AuthKind
  /// ScopeRules payload: { owner, include[], exclude[] }.
  scope     Json
  /// Defaults to `live`: an install upgrading into this keeps behaving exactly
  /// as it did, and switching is a decision.
  mode      SourceMode @default(live)
  /// Whether events are accepted for this source. An acceleration, never a
  /// prerequisite: the scheduled synchronisation stays correct without it, so
  /// an install whose network refuses inbound traffic simply leaves it off.
  /// Only meaningful in `stored` mode, which the service enforces.
  webhooksEnabled Boolean @default(false)
  /// How far back the ingestion reads for this source, in days. Only meaningful
  /// in `stored` mode — a live source asks its provider for the instant.
  ///
  /// Nullable, and null means "follow the reporting window": a source created
  /// before this, or one whose owner had no opinion, keeps exactly the depth it
  /// had, and follows the window when that one is widened.
  historyDays Int?
  /// The source a reader lands on when the address names none. At most one, and
  /// possibly none — an install with a single source has never needed to say.
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  envRules    SourceEnvRule[]
  trackers    SourceTracker[]
  snapshots   MetricSnapshot[]
  webhookSecret WebhookSecret?
  deliveries    WebhookDelivery[]
  repos        StoredRepo[]
  pullRequests StoredPullRequest[]
  pipelines    StoredPipeline[]
  deployments  StoredDeployment[]
  changelogs   DeploymentChangelog[]
  syncStates   SyncState[]
}

/// What a credential unlocks. A source spends its secret against a Git
/// platform, an LLM provider against a model API — neither is a special case of
/// the other, and both need the same envelope encryption.
enum CredentialOwner {
  source
  llmProvider
}

/// Access secret for whatever holds one, encrypted at rest (AES-256-GCM
/// envelope). Plaintext is never stored — see CryptoService.
///
/// Keyed by owner rather than by relation, like ApiQuota: a foreign key can
/// only point at one table. The cost is that no cascade reaches here, so every
/// owner deletes its own credential explicitly.
model Credential {
  id         String          @id @default(uuid())
  ownerType  CredentialOwner
  ownerId    String
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  /// Master key version that encrypted this secret (for rotation).
  keyVersion Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([ownerType, ownerId])
}

enum EnvRuleKind {
  simple
  meta
}

/// What the pattern is matched against: an environment name, a repo name, or
/// an incident label.
enum RuleTarget {
  environment
  repository
  incident
}

/// RegEx-based classification rule, defined once for the whole install and
/// applied to the sources that opt into it. Patterns describe naming
/// conventions, which rarely stop at one repository host.
/// simple: extracts attributes via named groups (type, client, ...).
/// meta:   groups every name matching the pattern.
model EnvRule {
  id         String      @id @default(uuid())
  name       String
  pattern    String
  kind       EnvRuleKind
  target     RuleTarget  @default(environment)
  /// Client-defined priority (lower wins).
  priority   Int         @default(100)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  sources    SourceEnvRule[]

  @@index([target, priority])
}

/// Which classification rules apply to a source. Written from the source, like
/// SourceTracker: what a source uses is the question one actually answers.
model SourceEnvRule {
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  rule      EnvRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId    String
  createdAt DateTime @default(now())

  @@id([sourceId, ruleId])
  @@index([ruleId])
}

enum TrackerKind {
  jira
  linear
  github
  gitlab
}

/// An issue tracker, declared once and attached to the sources it serves.
/// Git-hosted kinds (github, gitlab) read issues with the Git source's own
/// credentials; standalone ones (jira, linear) carry their own.
model Tracker {
  id        String      @id @default(uuid())
  name      String
  /// URL-safe form of the name, used by the frontend routes.
  slug      String      @unique
  kind      TrackerKind
  baseUrl   String
  /// Overrides the link shape derived from `kind`. `{key}` is always
  /// substituted; `{owner}` and `{repo}` only make sense for git-hosted kinds,
  /// which resolve them per pull request.
  urlTemplate String?
  /// Kind-specific settings: Jira project keys or JQL, Linear team, ...
  config      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sources     SourceTracker[]
  ticketRules TicketRule[]
}

/// Which trackers a source uses. Ticket rules already imply the link, but
/// incidents need it stated: "where do this source's incidents come from" is
/// not a question a ticket rule can answer.
model SourceTracker {
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  tracker   Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId String
  /// This tracker is where the source's incidents are read from.
  incidents Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([sourceId, trackerId])
  @@index([trackerId])
}

/// RegEx extracting ticket references from a branch name or a PR title.
/// Separate from EnvRule: it yields references, not attributes.
///
/// It belongs to a tracker and to nothing else — a key format is a property of
/// the tracker, not of a repository host. Which sources it applies to follows
/// from the sources attached to that tracker.
model TicketRule {
  id        String   @id @default(uuid())
  tracker   Tracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  trackerId String
  name      String
  pattern   String
  /// Client-defined priority (lower wins when two rules claim the same key).
  priority  Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackerId, priority])
}

/// Whose credentials the API calls are billed to. Git-hosted trackers reuse
/// their source's token, so they never appear here; standalone ones (Jira,
/// Linear) carry their own and do.
enum QuotaSubject {
  source
  tracker
}

/// Where the ceiling comes from. Kept explicit so the UI never presents a
/// hand-entered figure as a measured one.
enum QuotaOrigin {
  observed
  declared
}

/// Consumption of one provider rate-limit bucket. One row per bucket: GitHub
/// meters REST, GraphQL and search separately, on windows of different lengths.
model ApiQuota {
  id          String       @id @default(uuid())
  subjectKind QuotaSubject
  subjectId   String
  /// Provider bucket name — "core", "graphql", "search", "rest" for GitLab.
  bucket      String
  limit       Int
  used        Int
  /// End of the current window, as the provider reports it.
  resetAt     DateTime
  /// Window length. Null when the provider states neither it nor a default we
  /// know of — the reset date stays usable on its own.
  windowSec   Int?
  origin      QuotaOrigin
  observedAt  DateTime     @updatedAt

  @@unique([subjectKind, subjectId, bucket])
}

/// A ceiling stated by hand, for the instances that meter nothing — a
/// self-hosted GitLab with rate limiting off sends no header to read.
///
/// Kept apart from ApiQuota because it is configuration, not a reading: the
/// quota row it feeds is rewritten at every window, where what was declared has
/// to survive them all.
///
/// One per subject, not one per bucket: a response carrying no rate-limit
/// header names no bucket either, so the calls counted here have exactly one
/// ceiling to charge.
model ApiBudget {
  id          String       @id @default(uuid())
  subjectKind QuotaSubject
  subjectId   String
  /// Bucket the ceiling applies to — "core" for GitHub, "rest" for GitLab.
  bucket      String
  /// Calls allowed per window.
  limit       Int
  /// Window length, in seconds.
  windowSec   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([subjectKind, subjectId])
}

enum UserRole {
  admin
  user
}

/// Someone who can sign in. Roles are coarse on purpose: `admin` configures the
/// install, `user` only reads what the public setting would otherwise open to
/// everyone.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  /// scrypt, stored as `salt:derivedKey` in hex. Never the password itself.
  passwordHash String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Which overview this account reads, and on which ground. Null follows the
  /// installation default, so raising that default still moves everyone who
  /// never expressed a preference — which a stored copy of it would not.
  displayDirection String?
  displayMode      String?
  /// The language this account reads in. Null follows the browser, which is a
  /// better guess for somebody who never chose than any default here.
  language         String?

  sessions       Session[]
  passwordResets PasswordReset[]
}

/// A signed-in browser. Sessions live in the database rather than in a signed
/// token so that signing out, or removing a user, takes effect at once instead
/// of when a token happens to expire.
model Session {
  id        String   @id @default(uuid())
  /// SHA-256 of the cookie value: a leaked table must not hand out live sessions.
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A one-shot link an admin hands to someone who can no longer sign in. Hashed
/// like a session and for the same reason, short-lived, and single use — using
/// it deletes the row, along with every other outstanding link for that user.
model PasswordReset {
  id        String   @id @default(uuid())
  /// SHA-256 of the link's token: the table must not hand out live links.
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Application-wide setting, editable from the UI. A missing key falls back to
/// the matching environment variable, then to the built-in default.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Historized metric snapshot — the basis for DORA trends.
model MetricSnapshot {
  id         String   @id @default(uuid())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String
  metric     String
  value      Float
  /// Aggregation dimensions (env type, client, repo, ...).
  dimensions Json
  capturedAt DateTime @default(now())

  @@index([sourceId, metric, capturedAt])
}

/// Shared secret the webhooks of a source are authenticated with.
///
/// Kept apart from `Credential` rather than beside it: it authenticates calls
/// coming **in**, where that one authenticates calls going out. They rotate for
/// different reasons and one can exist without the other.
model WebhookSecret {
  id         String   @id @default(uuid())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String   @unique
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  /// Master key version that encrypted this secret (for rotation).
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One delivery already handled.
///
/// Providers deliver at least once and retry on anything that is not a quick
/// 2xx, so the same event arrives more than once as a matter of course. The
/// unique index below is what makes handling it twice a no-op — including
/// across several API instances, where an in-memory guard would not.
model WebhookDelivery {
  id         String   @id @default(uuid())
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String
  /// Identifier the provider stamps the delivery with.
  deliveryId String
  event      String
  receivedAt DateTime @default(now())

  @@unique([sourceId, deliveryId])
  /// Serves the "has this source heard anything lately" lookup the adaptive
  /// cadence asks on every run. The retention sweep scans instead, on a table
  /// kept small by that very sweep.
  @@index([sourceId, receivedAt])
}

/// Which listing a sync cursor belongs to.
enum SyncResource {
  repos
  pulls
  pipelines
  deployments
}

/// How far the ingestion has read a given listing, and how it went.
///
/// Deliberately the only thing a synchronisation consults to decide what to
/// fetch next: it must stay correct on an install where no webhook is ever
/// received, so it never derives its work from the events that arrived.
model SyncState {
  id             String       @id @default(uuid())
  source         Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId       String
  resource       SyncResource
  /// Lower bound handed to the next delta fetch. Null before the first run.
  cursor         DateTime?
  lastSyncAt     DateTime?
  /// Start of the last reconciliation pass — rows untouched since are stale.
  lastFullSyncAt DateTime?
  /// Message of the last failure, cleared by the next success.
  lastError      String?

  @@unique([sourceId, resource])
}

/// Repositories in scope, as the last synchronisation saw them. The repo filter
/// and every listing below are built from this in `stored` mode, where asking
/// the provider is exactly what we are avoiding.
model StoredRepo {
  id            String   @id @default(uuid())
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId      String
  name          String
  defaultBranch String?
  seenAt        DateTime

  @@unique([sourceId, name])
}

/// A pull request or merge request, open or merged.
///
/// One table for both: `MergedPullRequest` is the same object as `PullRequest`
/// with the lead-time timestamps filled in, and the connectors already give
/// them the same id. Splitting them would let one pull request exist twice,
/// with two answers to what state it is in.
model StoredPullRequest {
  id            String    @id @default(uuid())
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId      String
  repo          String
  /// Identity on the provider side — `gh:<repo>:<number>`, as the connectors
  /// build it. Both feeds agree on it, which is what keeps the row single.
  externalId    String
  number        Int
  title         String
  /// PullRequestState — open, draft, merged or closed.
  state         String
  /// Absent on a row the merged feed created: it reports no author.
  author        String?
  url           String
  /// Stored rather than derived: the shape of a repository URL is a connector's
  /// business, and re-deriving it here would be a second implementation of it.
  repoUrl       String?
  headRef       String
  openedAt      DateTime
  /// Last change the provider reported. The upsert guard reads this: an event
  /// older than what is stored describes a state we have already moved past.
  updatedAt     DateTime
  mergedAt      DateTime?
  reviewers     Int       @default(0)
  /// Lead-time segments. Null when the enrichment was given up under the quota
  /// reserve, which is why an upsert never overwrites a known value with null.
  firstCommitAt DateTime?
  firstReviewAt DateTime?
  /// Last sync or event that touched the row — what reconciliation compares.
  seenAt        DateTime

  @@unique([sourceId, externalId])
  @@index([sourceId, state, updatedAt])
  @@index([sourceId, mergedAt])
}

model StoredPipeline {
  id          String    @id @default(uuid())
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId    String
  repo        String
  externalId  String
  repoUrl     String?
  ref         String
  /// PipelineStatus.
  status      String
  url         String
  createdAt   DateTime
  updatedAt   DateTime
  durationSec Int?
  seenAt      DateTime

  @@unique([sourceId, externalId])
  @@index([sourceId, createdAt])
}

model StoredDeployment {
  id          String   @id @default(uuid())
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId    String
  repo        String
  externalId  String
  environment String
  ref         String
  /// PipelineStatus — `unknown` when the status call was given up.
  status      String
  /// Where the environment can be reached, when the platform states one. Null
  /// is the common case, and also what a run degraded under the API reserve
  /// leaves behind on GitHub — the status call carries both.
  environmentUrl String?
  /// Where the deployment itself is read on the platform — the run on GitHub,
  /// the job or the environment on GitLab. Null when neither states one, which
  /// on GitHub includes every run degraded under the reserve.
  url         String?
  createdAt   DateTime
  seenAt      DateTime

  @@unique([sourceId, externalId])
  @@index([sourceId, createdAt])
  @@index([sourceId, environment, createdAt])
}

/// What a deployment carried, written down while it could still be read.
///
/// Everything else in this file is a mirror of what the platform holds, kept
/// only as long as the reporting window and rebuilt from the provider if it
/// were lost. This one is the opposite: an environment is torn down, its branch
/// deleted, the deployment record aged out of the API — and the comparison that
/// produced these lines can never be made again. So it is written whole, and
/// the retention sweep does not touch it.
///
/// Held per source and keyed on the provider's own deployment id: the row in
/// StoredDeployment is purged with the window, and nothing else survives it.
model DeploymentChangelog {
  id             String   @id @default(uuid())
  source         Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId       String
  /// Identity on the provider side, as the connectors build it — the handle
  /// that outlives the deployment row itself.
  deploymentId   String
  repo           String
  environment    String
  /// The deployed ref, and what it was compared against. Null when nothing
  /// preceded it: a first deployment to an environment carries everything, and
  /// saying so is the honest record.
  ref            String
  baseRef        String?
  /// DeploymentBase — which question the comparison answered.
  base           String
  /// The platform's pages, stored rather than derived: a link is only useful if
  /// it still points where it did, and the source it was built from may since
  /// have been re-scoped, moved, or pointed at another host.
  refUrl         String
  baseRefUrl     String?
  deploymentUrl  String?
  environmentUrl String?
  /// PipelineStatus as of the archiving.
  status         String
  /// ReleaseNoteEntry[] — the structured reading, kept beside the rendered text
  /// because rendering it again (another generator, a rewrite, a translation)
  /// must not need the platform back.
  entries        Json
  markdown       String
  /// Distinct authors over the range, and how many commits it held. Counted
  /// into columns because the history page lists them without reading the two
  /// heavy fields above — a page of a hundred releases would otherwise carry
  /// every commit message of each.
  authors        Int
  commits        Int
  /// Filed without contents: the platform would not resolve the refs when the
  /// archiver got to it — a branch deleted on merge, a commit pruned. Recorded
  /// rather than retried, because a 404 on a compare does not become false
  /// again, and a deployment retried for ever would hold the batch against the
  /// ones that can still be read. What it says is true and worth keeping: this
  /// went out, and what it carried is no longer knowable.
  unreadable     Boolean  @default(false)
  /// ReleaseNotesGenerator that produced `markdown`.
  generator      String
  deployedAt     DateTime
  archivedAt     DateTime @default(now())

  @@unique([sourceId, deploymentId])
  @@index([sourceId, deployedAt])
  @@index([sourceId, repo, environment, deployedAt])
}

/// Which vendor's API a provider talks to. It decides the request shape and the
/// authentication header, not the model — that is a free string, since vendors
/// ship new ones far more often than they change their API.
enum LlmKind {
  anthropic
  openai
  google
  mistral
}

/// A model API the install may call, declared once with its key. Several may
/// coexist — one per vendor, or two of the same vendor on different models —
/// and the caller picks which one it wants.
///
/// Its key lives in Credential, keyed by `llmProvider`, so no cascade removes
/// it: the service deletes it with the row.
model LlmProvider {
  id        String   @id @default(uuid())
  name      String
  kind      LlmKind
  /// Vendor model identifier, as the vendor spells it.
  model     String
  /// Overrides the vendor's public endpoint — a gateway, a proxy, or a
  /// compatible self-hosted deployment. Null uses the built-in default.
  baseUrl   String?
  /// The one a caller gets when it names none. At most one row carries it,
  /// which the service enforces by clearing the others.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
