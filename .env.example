# ─── API ─────────────────────────────────────────────────────────────
API_PORT=3001
# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard?schema=public

# ─── Redis (jobs / cache) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Collection schedule (cron). Default: every 15 minutes.
COLLECT_CRON=*/15 * * * *

# ─── Secrets encryption ──────────────────────────────────────────────
# Path to the master key file. Generated automatically on first boot
# with 0600 permissions if it does not exist.
MASTER_KEY_FILE=./data/master.key
# Optional: provide the master key directly (base64, 32 bytes) instead of
# a file — useful for Kubernetes / external secret managers. Takes
# precedence over MASTER_KEY_FILE when set.
# MASTER_KEY=

# ─── Web (Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
