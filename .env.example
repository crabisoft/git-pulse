# ─── API ─────────────────────────────────────────────────────────────
API_PORT=3001
# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173

# Session cookie restricted to HTTPS. Defaults to whether WEB_ORIGIN is
# https://, which is right unless TLS is terminated by a proxy in front.
# SESSION_COOKIE_SECURE=true

# Number of reverse-proxy hops in front of the API, so the sign-in throttle
# counts the caller rather than the proxy. Leave unset when nothing proxies it:
# trusting X-Forwarded-For then lets a caller choose its own address.
# TRUST_PROXY=1

# ─── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard?schema=public

# ─── Redis (jobs / cache) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Collection schedule, DORA window, page size and stale-PR threshold are not
# environment variables: they live in the database, editable from Settings.

# ─── Secrets encryption ──────────────────────────────────────────────
# Path to the master key file. Generated automatically on first boot
# with 0600 permissions if it does not exist.
MASTER_KEY_FILE=./data/master.key
# Optional: provide the master key directly (base64, 32 bytes) instead of
# a file — useful for Kubernetes / external secret managers. Takes
# precedence over MASTER_KEY_FILE when set.
# MASTER_KEY=

# ─── Web (Vite) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
