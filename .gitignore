node_modules/
dist/
build/
coverage/

# Local env & secrets — NEVER commit
.env
.env.local
*.local
# ...but the Docker defaults file IS versioned (no real secrets in it)
!.docker/.env
data/
*.key
!/*.key.example

# Prisma generated client
back/src/generated/
.prisma/
# One-off catch-up SQL for migrations amended after being applied locally.
# Written for one developer's database state, never part of the chain.
back/prisma/manual/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Layout suite output. The screenshots are written on every run and read by
# whoever is looking at a change; the assertions are what fail, and they leave
# nothing behind worth versioning.
front/e2e/screens/
front/e2e/.results/
front/playwright-report/
# Where a run started outside the front package leaves its own.
test-results/
